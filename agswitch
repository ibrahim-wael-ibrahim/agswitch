#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly BASE="${XDG_CONFIG_HOME:-$HOME/.config}/agswitch"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agswitch"
readonly CURRENT_FILE="$BASE/current"
readonly LOG_FILE="$STATE_DIR/antigravity.log"

readonly APP="/opt/Antigravity/antigravity"
readonly SERVICE="gemini"
readonly USERNAME="antigravity"
readonly TARGET="gemini:antigravity"
readonly LABEL="Password for 'antigravity' on 'gemini'"

readonly -a LOOKUP_ATTRS=(
    service "$SERVICE"
    username "$USERNAME"
)

# Storing target as well is compatible with both broad and specific lookups.
readonly -a STORE_ATTRS=(
    service "$SERVICE"
    target "$TARGET"
    username "$USERNAME"
)

ROLLBACK_ACTIVE=0
ROLLBACK_HAD_SECRET=0
ROLLBACK_FILE=""

usage() {
    cat <<'USAGE'
Usage:
  agswitch save [--force] <profile>  Save the active Antigravity credential
  agswitch use <profile>             Switch to a saved profile
  agswitch <profile>                 Same as: agswitch use <profile>
  agswitch list                      List saved profiles
  agswitch current                   Print the current profile
  agswitch status                    Print profile and process status
  agswitch delete <profile>          Delete a saved profile
  agswitch                           Pick a profile with fzf, when installed
USAGE
}

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

init_dirs() {
    mkdir -p "$BASE" "$STATE_DIR"
    chmod 700 "$BASE" "$STATE_DIR"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

require_tools() {
    require_command secret-tool
    require_command pgrep
    require_command flock
}

validate_profile() {
    local profile="$1"

    [[ "$profile" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
        die "Invalid profile name: $profile"
}

profile_path() {
    printf '%s/%s.json\n' "$BASE" "$1"
}

acquire_lock() {
    exec 9>"$STATE_DIR/agswitch.lock"
    flock -n 9 || die "Another agswitch operation is already running"
}

lookup_secret_to_file() {
    local output_file="$1"
    secret-tool lookup "${LOOKUP_ATTRS[@]}" >"$output_file"
}

store_secret_from_file() {
    local input_file="$1"
    secret-tool store \
        --label="$LABEL" \
        "${STORE_ATTRS[@]}" \
        <"$input_file"
}

clear_active_secret() {
    # One broad clear removes all unlocked entries matching service+username,
    # including entries which also have a target attribute.
    secret-tool clear "${LOOKUP_ATTRS[@]}" >/dev/null 2>&1 || true
}

app_pids() {
    pgrep -f -- "$APP" || true
}

app_is_running() {
    pgrep -f -- "$APP" >/dev/null 2>&1
}

stop_app() {
    local -a pids=()
    local attempt

    mapfile -t pids < <(app_pids)
    ((${#pids[@]} > 0)) || return 0

    kill -TERM "${pids[@]}" 2>/dev/null || true

    for ((attempt = 0; attempt < 40; attempt++)); do
        app_is_running || return 0
        sleep 0.25
    done

    printf 'Antigravity did not stop gracefully; forcing shutdown...\n' >&2
    mapfile -t pids < <(app_pids)
    ((${#pids[@]} == 0)) || kill -KILL "${pids[@]}" 2>/dev/null || true

    for ((attempt = 0; attempt < 20; attempt++)); do
        app_is_running || return 0
        sleep 0.25
    done

    return 1
}

start_app() {
    [[ -x "$APP" ]] || die "Antigravity executable not found: $APP"
    nohup "$APP" >>"$LOG_FILE" 2>&1 </dev/null &
}

wait_for_app() {
    local attempt

    for ((attempt = 0; attempt < 40; attempt++)); do
        if app_is_running; then
            # Avoid reporting success for a process which crashes immediately.
            sleep 1
            app_is_running && return 0
        fi
        sleep 0.25
    done

    return 1
}

restore_previous_secret() {
    clear_active_secret

    if ((ROLLBACK_HAD_SECRET == 1)) && [[ -s "$ROLLBACK_FILE" ]]; then
        store_secret_from_file "$ROLLBACK_FILE" >/dev/null 2>&1 || true
    fi
}

on_exit() {
    local status=$?

    trap - EXIT INT TERM

    if ((status != 0 && ROLLBACK_ACTIVE == 1)); then
        printf 'Switch failed; restoring the previous credential...\n' >&2
        restore_previous_secret

        if ! app_is_running; then
            start_app >/dev/null 2>&1 || true
        fi
    fi

    [[ -z "$ROLLBACK_FILE" ]] || rm -f -- "$ROLLBACK_FILE"
    exit "$status"
}

trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

get_profiles() {
    find "$BASE" \
        -maxdepth 1 \
        -type f \
        -name '*.json' \
        -printf '%f\n' 2>/dev/null |
        sed 's/\.json$//' |
        sort
}

save_profile() {
    local force=0
    local profile path temp_file

    if [[ "${1:-}" == "--force" ]]; then
        force=1
        shift
    fi

    profile="${1:-}"
    [[ -n "$profile" && $# -eq 1 ]] || die "Usage: agswitch save [--force] <profile>"
    validate_profile "$profile"

    path="$(profile_path "$profile")"

    if [[ -e "$path" && $force -eq 0 ]]; then
        die "Profile already exists. Use: agswitch save --force $profile"
    fi

    acquire_lock
    temp_file="$(mktemp "$BASE/.${profile}.tmp.XXXXXX")"

    if ! lookup_secret_to_file "$temp_file"; then
        rm -f -- "$temp_file"
        die "No active Antigravity credential was found in the keyring"
    fi

    if [[ ! -s "$temp_file" ]]; then
        rm -f -- "$temp_file"
        die "The active keyring credential is empty"
    fi

    chmod 600 "$temp_file"
    mv -f -- "$temp_file" "$path"
    printf '%s\n' "$profile" >"$CURRENT_FILE"
    chmod 600 "$CURRENT_FILE"

    printf 'Saved: %s\n' "$profile"
}

use_profile() {
    local profile="${1:-}"
    local path

    [[ -n "$profile" && $# -eq 1 ]] || die "Usage: agswitch use <profile>"
    validate_profile "$profile"

    path="$(profile_path "$profile")"
    [[ -f "$path" ]] || die "Profile not found: $profile"
    [[ ! -L "$path" ]] || die "Profile files cannot be symbolic links"
    [[ -s "$path" ]] || die "Profile is empty: $profile"
    chmod 600 "$path"

    acquire_lock

    ROLLBACK_FILE="$(mktemp "$STATE_DIR/previous-secret.XXXXXX")"
    chmod 600 "$ROLLBACK_FILE"

    if lookup_secret_to_file "$ROLLBACK_FILE" 2>/dev/null; then
        ROLLBACK_HAD_SECRET=1
    else
        : >"$ROLLBACK_FILE"
    fi

    ROLLBACK_ACTIVE=1

    printf 'Stopping Antigravity...\n'
    stop_app || die "Could not stop Antigravity"

    printf 'Switching keyring...\n'
    clear_active_secret
    store_secret_from_file "$path"

    printf 'Starting Antigravity...\n'
    start_app
    wait_for_app || die "Antigravity failed to start. Check: $LOG_FILE"

    printf '%s\n' "$profile" >"$CURRENT_FILE"
    chmod 600 "$CURRENT_FILE"

    ROLLBACK_ACTIVE=0
    printf 'Done: %s\n' "$profile"
}

list_profiles() {
    local current=""
    local -a profiles=()
    local profile

    [[ -f "$CURRENT_FILE" ]] && current="$(<"$CURRENT_FILE")"
    mapfile -t profiles < <(get_profiles)

    if ((${#profiles[@]} == 0)); then
        printf 'No saved profiles.\n'
        return 0
    fi

    printf 'Available profiles:\n'
    for profile in "${profiles[@]}"; do
        if [[ "$profile" == "$current" ]]; then
            printf '  * %s (current)\n' "$profile"
        else
            printf '    %s\n' "$profile"
        fi
    done
}

show_current() {
    if [[ -s "$CURRENT_FILE" ]]; then
        cat "$CURRENT_FILE"
    else
        printf 'unknown\n'
    fi
}

show_status() {
    printf 'Current profile: '
    show_current

    if app_is_running; then
        printf 'Antigravity: running\n'
    else
        printf 'Antigravity: stopped\n'
    fi
}

delete_profile() {
    local profile="${1:-}"
    local path current=""

    [[ -n "$profile" && $# -eq 1 ]] || die "Usage: agswitch delete <profile>"
    validate_profile "$profile"

    path="$(profile_path "$profile")"
    [[ -f "$path" ]] || die "Profile not found: $profile"
    [[ -f "$CURRENT_FILE" ]] && current="$(<"$CURRENT_FILE")"

    if [[ "$profile" == "$current" ]]; then
        die "Cannot delete the current profile; switch to another profile first"
    fi

    acquire_lock
    rm -f -- "$path"
    printf 'Deleted: %s\n' "$profile"
}

pick_profile() {
    local selected
    local -a profiles=()

    mapfile -t profiles < <(get_profiles)
    ((${#profiles[@]} > 0)) || die "No saved profiles"

    if ! command -v fzf >/dev/null 2>&1; then
        list_profiles
        die "fzf is not installed; use: agswitch use <profile>"
    fi

    selected="$(printf '%s\n' "${profiles[@]}" | fzf --prompt='agswitch> ')"
    [[ -n "$selected" ]] || exit 0
    use_profile "$selected"
}

init_dirs
require_tools

command_name="${1:-}"

case "$command_name" in
    save)
        shift
        save_profile "$@"
        ;;
    use)
        shift
        use_profile "$@"
        ;;
    list|ls)
        (($# == 1)) || die "Usage: agswitch list"
        list_profiles
        ;;
    current)
        (($# == 1)) || die "Usage: agswitch current"
        show_current
        ;;
    status)
        (($# == 1)) || die "Usage: agswitch status"
        show_status
        ;;
    delete|rm)
        shift
        delete_profile "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    '')
        pick_profile
        ;;
    *)
        (($# == 1)) || die "Usage: agswitch <profile>"
        use_profile "$command_name"
        ;;
esac
